@page "/students"
@inject Tutorplanner.Data.TutorDbContext Db
@inject Tutorplanner.Services.TutorPlannerService Planner

<PageTitle>Students</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div><p class="eyebrow">PEOPLE</p><h1>Students</h1><p class="text-muted mb-0">Manage your students and their accounts.</p></div>
	<button class="btn btn-primary" @onclick="OpenForm">+ Add student</button>
</div>

@if (showForm)
{
	<div class="section-card mb-4">
		<div class="section-heading"><h2>New student</h2><button class="icon-button" @onclick="CloseForm">×</button></div>
		<EditForm Model="form" OnValidSubmit="SaveStudent">
			<DataAnnotationsValidator />
			<div class="row g-3">
				<div class="col-md-6"><label>Name *</label><InputText @bind-Value="form.Name" class="form-control" placeholder="e.g. Emma Johnson" /><ValidationMessage For="@(() => form.Name)" /></div>
				<div class="col-md-6"><label>Email</label><InputText @bind-Value="form.Email" class="form-control" placeholder="emma@example.com" /></div>
				<div class="col-md-6"><label>Phone</label><InputText @bind-Value="form.Phone" class="form-control" placeholder="Optional" /></div>
				<div class="col-md-6"><label>Notes</label><InputText @bind-Value="form.Notes" class="form-control" placeholder="School, subject, or other notes" /></div>
			</div>
			<div class="form-actions"><button class="btn btn-primary" type="submit">Save student</button><button class="btn btn-light" type="button" @onclick="CloseForm">Cancel</button></div>
		</EditForm>
	</div>
}

<div class="section-card">
	@if (students.Count == 0)
	{
		<div class="empty-state"><h2>No students yet</h2><p>Add your first student to start planning lessons.</p><button class="btn btn-primary" @onclick="OpenForm">Add student</button></div>
	}
	else
	{
		<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Contact</th><th>Balance</th><th></th></tr></thead><tbody>
		@foreach (var student in students)
		{
			<tr><td><NavLink class="student-link" href="@($"/student/{student.Id}")"><span class="avatar">@Initials(student.Name)</span><strong>@student.Name</strong></NavLink></td><td><span class="text-muted">@(string.IsNullOrWhiteSpace(student.Email) ? "No email" : student.Email)</span></td><td><span class="badge-soft">@CurrencyFormatter.Gel(Balances.GetValueOrDefault(student.Id))</span></td><td class="text-end"><NavLink class="btn btn-sm btn-outline-primary" href="@($"/student/{student.Id}")">Open account</NavLink></td></tr>
		}
		</tbody></table></div>
	}
</div>

@code {
	private List<Student> students = new();
	private Dictionary<int, decimal> Balances = new();
	private bool showForm;
	private StudentForm form = new();

	protected override async Task OnInitializedAsync()
	{
		await LoadStudents();
	}

	private async Task LoadStudents()
	{
		students = await Db.Students.Where(s => s.IsActive).OrderBy(s => s.Name).ToListAsync();
		Balances = new Dictionary<int, decimal>();
		foreach (var student in students)
		{
			Balances[student.Id] = (await Planner.GetBalanceAsync(student.Id)).Outstanding;
		}
	}

	private void OpenForm() { form = new(); showForm = true; }
	private void CloseForm() { showForm = false; }

	private async Task SaveStudent()
	{
		if (string.IsNullOrWhiteSpace(form.Name)) return;
		Db.Students.Add(new Student { Name = form.Name.Trim(), Email = form.Email.Trim(), Phone = form.Phone.Trim(), Notes = form.Notes.Trim() });
		await Db.SaveChangesAsync();
		await LoadStudents();
		showForm = false;
	}

	private static string Initials(string name) => string.Join(string.Empty, name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();

	private sealed class StudentForm
	{
		[System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a student name.")]
		public string Name { get; set; } = string.Empty;
		public string Email { get; set; } = string.Empty;
		public string Phone { get; set; } = string.Empty;
		public string Notes { get; set; } = string.Empty;
	}
}